{
    "name": "macbook/backend",
    "type": "project",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "."
        },
        "files": ["core/Autoload.php"]
    },
    "authors": [
        {
            "name": "edinsontique264717",
            "email": "edinsontique264717@correo.itm.edu.co"
        }
    ],
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "test/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-converage": "phpunit  --coverage-clover=coverage/clover.xml --coverage-html=coverage/html --log-junit=coverage/junit.xml",
        "test-watch": "phpunit --testdox",
        "sonar": "sonar-scanner"
    }
}
